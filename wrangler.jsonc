// Publicação no Cloudflare (Workers com arquivos estáticos).
// O build (npm run build) gera dist/; rotas desconhecidas voltam para o app (SPA).
{
  "name": "frota-dipaes",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
